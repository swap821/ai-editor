{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend-api",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "aios", "--reload"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "executor-service",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "aios.executor_service"],
      "port": 8081
    }
  ]
}
