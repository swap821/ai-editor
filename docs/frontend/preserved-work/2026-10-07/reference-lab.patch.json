    "@@ -0,0 +1,30 @@",
    "+export interface PortraitCameraAdjustment {",
    "+  distance: number;",
    "+  lookAtY: number;",
    "+}",
    "+",
    "+const PORTRAIT_START_ASPECT = 1.05;",
    "+const PORTRAIT_FULL_ASPECT = 0.48;",
    "+const MAX_PORTRAIT_DISTANCE = 2.8;",
    "+const MAX_PORTRAIT_LOOK_AT_SHIFT = -0.25;",
    "+",
    "+const clamp01 = (value: number): number => Math.max(0, Math.min(1, value));",
    "+",
    "+/**",
    "+ * Widen the vertical scene frame only as the canvas becomes portrait-shaped.",
    "+ * Desktop keeps its established composition; phone framing makes room for the",
    "+ * cortex, spinal trunk, and lower nerve roots instead of cropping them away.",
    "+ */",
    "+export function portraitCameraAdjustment(aspect: number): PortraitCameraAdjustment {",
    "+  if (!Number.isFinite(aspect) || aspect <= 0) return { distance: 0, lookAtY: 0 };",
    "+",
    "+  const portrait = clamp01(",
    "+    (PORTRAIT_START_ASPECT - aspect) / (PORTRAIT_START_ASPECT - PORTRAIT_FULL_ASPECT),",
    "+  );",
    "+  if (portrait === 0) return { distance: 0, lookAtY: 0 };",
    "+",
    "+  return {",
    "+    distance: portrait * MAX_PORTRAIT_DISTANCE,",
    "+    lookAtY: portrait * MAX_PORTRAIT_LOOK_AT_SHIFT,",
    "+  };",
    "+}",
